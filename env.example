# Copy this file to .env, then replace example secrets before starting.
# Keep POSTGRES_PASSWORD URL-safe (letters and digits), because it is used in DATABASE_URL.
POSTGRES_USER=rworld_user
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_PASSWORD
POSTGRES_DB=rworld_db
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_JWT_SECRET

# Published image tag: latest or sha-<full-commit-sha>
IMAGE_TAG=latest

# Host ports (change if in use)
BACKEND_PORT=3001
FRONTEND_PORT=4201
